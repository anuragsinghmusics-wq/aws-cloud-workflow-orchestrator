# ============================================================================
# AWS Cloud Workflow Orchestrator - Environment Configuration Template
# Copy this file to .env or .env.development and modify as needed.
# ============================================================================

# ----------------------------------------------------------------------------
# Application & Runtime
# ----------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="AWS Cloud-Native Workflow Orchestrator"
VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# ----------------------------------------------------------------------------
# AWS Services & LocalStack Simulation
# When USE_LOCALSTACK=true, requests route to LOCALSTACK_ENDPOINT_URL.
# No real AWS credentials or charges are incurred.
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT_URL=http://localhost:4566

# S3 Object Storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=cloud-orchestrator-payload-staging
S3_STAGING_PREFIX=payloads
S3_MULTIPART_THRESHOLD_MB=5

# DynamoDB Datastore & State Ledger
DYNAMODB_ENDPOINT_URL=
DYNAMODB_STATE_TABLE=Orchestrator_Workflow_Ledger
DYNAMODB_DEFAULT_TARGET_TABLE=Migrated_Production_Records
DYNAMODB_MAX_BATCH_SIZE=25

# CloudWatch Telemetry
CLOUDWATCH_ENDPOINT_URL=
CLOUDWATCH_NAMESPACE=CloudWorkflowOrchestrator
CLOUDWATCH_LOG_GROUP=/aws/orchestrator/workflows

# ----------------------------------------------------------------------------
# PostgreSQL Relational Metadata Database
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestrator_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# Redis & Celery Distributed Task Broker
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=orchestrator_tasks
CELERY_TASK_TIME_LIMIT=1800

# ----------------------------------------------------------------------------
# Worker Concurrency & Resilience
# ----------------------------------------------------------------------------
WORKER_CONCURRENCY=4
MAX_RETRIES=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# ----------------------------------------------------------------------------
# Security & JWT Authentication
# GENERATE A STRONG KEY IN PRODUCTION: openssl rand -hex 32
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=insecure-dev-secret-change-in-production-09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
